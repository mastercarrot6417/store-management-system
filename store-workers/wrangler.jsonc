{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store-management-system",
  // Shenmpang1@gmail.com's Account. Pinned so wrangler can never deploy this to another account.
  "account_id": "9d997b3c1ae96e000381927fc2cc6ac2",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  // postgres.js needs Node.js APIs (net, tls, crypto).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // No public store-management-system.<subdomain>.workers.dev address until go-live.
  "workers_dev": false,
  // Each uploaded version (e.g. from a branch build) gets its own preview link:
  // <version>-store-management-system.shenmpang1.workers.dev
  "preview_urls": true,

  // CSS, JS and images. Files here are served directly; everything else goes to the Worker.
  "assets": { "directory": "./public" },

  "vars": {
    "COMPANY_MAP_QUERY": "MY DREAM BIKE SDN BHD",
    // Google Maps link for the store (footer "Store Location"). Empty = search link for the shop name.
    "COMPANY_MAP_LINK": "",
    // Google Maps Embed API key for the homepage map. It's visible in the page anyway,
    // so it isn't a secret: restrict it to your domain in Google Cloud Console.
    // Empty = show a "Find us in-store" box instead of the map.
    "GOOGLE_MAPS_API_KEY": ""
  },

  // Set with `npx wrangler secret put <NAME>`; locally in .env (see .env.example).
  "secrets": {
    "required": ["COOKIE_SECRET"]
  },

  "hyperdrive": [
    {
      // Public shop pages: read queries may be cached for a short time.
      "binding": "HYPERDRIVE",
      "id": "6efc5b413fe04b05ae5abc861050b8d8"
    },
    {
      // Admin, stock and checkout: caching disabled so stock is never stale.
      "binding": "HYPERDRIVE_NOCACHE",
      "id": "d76f999f1afc4422baa1cb93fa0527d2"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "store-images",
      "preview_bucket_name": "store-images-dev"
    }
  ],

  "triggers": {
    // 19:00 UTC = 03:00 Malaysia time: delete expired login sessions.
    "crons": ["0 19 * * *"]
  }
}
