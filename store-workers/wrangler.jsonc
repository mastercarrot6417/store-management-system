{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store-workers",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  // postgres.js needs Node.js APIs (net, tls, crypto).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // CSS, JS and images. Files here are served directly; everything else goes to the Worker.
  "assets": { "directory": "./public" },

  "vars": {
    "COMPANY_MAP_QUERY": "MY DREAM BIKE SDN BHD",
    // Google Maps link for the store (footer "Store Location"). Empty = search link for the shop name.
    "COMPANY_MAP_LINK": ""
  },

  // Set with `npx wrangler secret put <NAME>`; locally in .env (see .env.example).
  "secrets": {
    "required": ["COOKIE_SECRET"]
  },

  "hyperdrive": [
    {
      // Public shop pages: read queries may be cached for a short time.
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_CACHED_HYPERDRIVE_ID"
    },
    {
      // Admin, stock and checkout: caching disabled so stock is never stale.
      "binding": "HYPERDRIVE_NOCACHE",
      "id": "REPLACE_WITH_NOCACHE_HYPERDRIVE_ID"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "store-images",
      "preview_bucket_name": "store-images-dev"
    }
  ],

  "triggers": {
    // 19:00 UTC = 03:00 Malaysia time: delete expired login sessions.
    "crons": ["0 19 * * *"]
  }
}
