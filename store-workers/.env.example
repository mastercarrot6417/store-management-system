# Copy to .env (same folder) and fill in. .env is ignored by git.
# Use the DEVELOPMENT Supabase project here, never production.
# Supabase dashboard -> Connect -> copy the connection string.

# Used by `npm run db:migrate`.
DATABASE_URL=

# Used by `npm run dev` in place of Hyperdrive (both can be the same dev database).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_NOCACHE=
